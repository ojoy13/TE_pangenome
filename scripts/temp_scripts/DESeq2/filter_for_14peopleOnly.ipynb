    "import pandas as pd\n",
    "import numpy as np\n",
    "import plotly.express as px"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "897f11e3-7c8c-4500-8451-5c3633d45509",
   "metadata": {},
   "outputs": [],
   "source": [
    "avcf = \"/TE_pangenome/outputs/TE_pangenome_construction/filtered_pangenome/TE_pangenome_21samples.vcf.gz\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "d5596442-31be-4084-ae99-1393e0ca4806",
   "metadata": {},
   "outputs": [],
   "source": [
    "import gzip\n",
    "from typing import Tuple, List, Dict, Any\n",
    "\n",
    "\n",
    "def smart_open(path, mode=\"rt\"):\n",
    "    \"\"\"\n",
    "    Open plain or .gz file transparently.\n",
    "    mode: 'rt' for text read, 'wt' for text write, etc.\n",
    "    \"\"\"\n",
    "    if str(path).endswith(\".gz\"):\n",
    "        return gzip.open(path, mode=mode)\n",
    "    else:\n",
    "        return open(path, mode=mode)\n",
    "\n",
    "\n",
    "def parse_info_field(info_str: str) -> Dict[str, Any]:\n",
    "    \"\"\"Parse INFO string into a dict of key -> value (or True for flag fields).\"\"\"\n",
    "    info = {}\n",
    "    if info_str == \".\":\n",
    "        return info\n",
    "    for item in info_str.split(\";\"):\n",
    "        if \"=\" in item:\n",
    "            key, val = item.split(\"=\", 1)\n",
    "            info[key] = val\n",
    "        else:\n",
    "            # flag field\n",
    "            info[item] = True\n",
    "    return info\n",
    "\n",
    "\n",
    "def parse_format_and_samples(format_str: str,\n",
    "                             sample_fields: List[tuple]) -> List[Dict[str, Any]]:\n",
    "    \"\"\"\n",
    "    Given FORMAT string and list of (sample_name, sample_str),\n",
    "    return a list of dicts: [{field -> value, \"__sample__\": sample_name}, ...]\n",
    "    \"\"\"\n",
    "    keys = format_str.split(\":\")\n",
    "    sample_dicts = []\n",
    "    for sample_name, sample_str in sample_fields:\n",
    "        values = sample_str.split(\":\")\n",
    "        data = dict(zip(keys, values))\n",
    "        data[\"__sample__\"] = sample_name\n",
    "        sample_dicts.append(data)\n",
    "    return sample_dicts\n",
    "\n",
    "\n",
    "def read_vcf(path: str):\n",
    "    \"\"\"\n",
    "    Minimal VCF reader supporting both plain .vcf and .vcf.gz.\n",
    "\n",
    "    Returns:\n",
    "      header: dict with keys:\n",
    "        - meta: list of '##' header lines\n",
    "        - columns: list of VCF column names (CHROM, POS, ..., FORMAT, samples...)\n",
    "      records: list of dicts; each dict has:\n",
    "        - CHROM, POS, ID, REF, ALT, QUAL, FILTER\n",
    "        - INFO: dict\n",
    "        - FORMAT: FORMAT string (or None)\n",
    "        - samples: list of per-sample dicts (may be empty)\n",
    "    \"\"\"\n",
    "    meta = []\n",
    "    columns = None\n",
    "    records = []\n",
    "\n",
    "    with smart_open(path, \"rt\") as f:  # text mode works for gzip and plain files [web:10][web:13]\n",
    "        for line in f:\n",
    "            line = line.rstrip(\"\\n\")\n",
    "            if not line:\n",
    "                continue\n",
    "\n",
    "            if line.startswith(\"##\"):\n",
    "                meta.append(line)\n",
    "                continue\n",
    "\n",
    "            if line.startswith(\"#CHROM\"):\n",
    "                columns = line.lstrip(\"#\").split(\"\\t\")\n",
    "                continue\n",
    "\n",
    "            # data line\n",
    "            fields = line.split(\"\\t\")\n",
    "            if columns is None:\n",
    "                raise ValueError(\"VCF header (#CHROM line) not found before data\")\n",
    "\n",
    "            chrom, pos, vid, ref, alt, qual, filt, info_str = fields[:8]\n",
    "            pos = int(pos)\n",
    "\n",
    "            record = {\n",
    "                \"CHROM\": chrom,\n",
    "                \"POS\": pos,\n",
    "                \"ID\": vid,\n",
    "                \"REF\": ref,\n",
    "                \"ALT\": alt.split(\",\"),     # keep ALT as list\n",
    "                \"QUAL\": qual if qual != \".\" else None,\n",
    "                \"FILTER\": filt.split(\";\") if filt not in (\".\", \"\") else [],\n",
    "                \"INFO\": parse_info_field(info_str),\n",
    "                \"FORMAT\": None,\n",
    "                \"samples\": []\n",
    "            }\n",
    "\n",
    "            if len(fields) > 8:\n",
    "                format_str = fields[8]\n",
    "                sample_names = columns[9:]\n",
    "                sample_values = fields[9:]\n",
    "                sample_fields = list(zip(sample_names, sample_values))\n",
    "                record[\"FORMAT\"] = format_str\n",
    "                record[\"samples\"] = parse_format_and_samples(format_str, sample_fields)\n",
    "\n",
    "            records.append(record)\n",
    "\n",
    "    header = {\"meta\": meta, \"columns\": columns}\n",
    "    return header, records"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "c16cea72-e8d3-496f-b969-0bcaf7e85633",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def records_to_genotype_df(header, records):\n",
    "    \"\"\"\n",
    "    Build sample x variant genotype DataFrame from parsed VCF records.\n",
    "\n",
    "    header: dict from read_vcf()\n",
    "    records: list of record dicts from read_vcf()\n",
    "\n",
    "    Returns: DataFrame with index = sample IDs, columns = variant IDs,\n",
    "             values = GT strings or NaN.\n",
    "    \"\"\"\n",
    "    columns = header[\"columns\"]\n",
    "    sample_names = columns[9:]  # after FORMAT\n",
    "    n_samples = len(sample_names)\n",
    "\n",
    "    # Variant IDs and per-variant GT lists\n",
    "    variant_ids = []\n",
    "    gt_matrix = []  # list of length-n_samples lists\n",
    "\n",
    "    for rec in records:\n",
    "        # robust variant identifier\n",
    "        vid = rec[\"ID\"]\n",
    "        if not vid or vid == \".\":\n",
    "            alt_str = \",\".join(rec[\"ALT\"])\n",
    "            vid = f\"{rec['CHROM']}:{rec['POS']}:{rec['REF']}:{alt_str}\"\n",
    "        variant_ids.append(vid)\n",
    "\n",
    "        # rec[\"samples\"] is list of dicts from parse_format_and_samples\n",
    "        # We assume GT key exists when FORMAT has GT\n",
    "        gts = []\n",
    "        per_sample = rec[\"samples\"]\n",
    "\n",
    "        # Map sample_name -> sample_dict for safety\n",
    "        by_name = {s[\"__sample__\"]: s for s in per_sample}\n",
    "\n",
    "        for sname in sample_names:\n",
    "            sd = by_name.get(sname)\n",
    "            if sd is None:\n",
    "                gts.append(np.nan)\n",
    "            else:\n",
    "                gt = sd.get(\"GT\", None)\n",
    "                if gt is None or gt == \".\" or gt == \"./.\":\n",
    "                    gts.append(np.nan)\n",
    "                else:\n",
    "                    gts.append(gt)\n",
    "\n",
    "        gt_matrix.append(gts)\n",
    "\n",
    "    # Now build DataFrame: samples x variants\n",
    "    # current shape of gt_matrix: n_variants x n_samples\n",
    "    df = pd.DataFrame(\n",
    "        data=np.array(gt_matrix, dtype=object).T,\n",
    "        index=sample_names,\n",
    "        columns=variant_ids,\n",
    "    )\n",
    "    return df"
   ]
  },
